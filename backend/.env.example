# Copy to .env for running the API outside docker-compose.
UNI_DATABASE_URL=postgresql+psycopg://uni:uni@localhost:5432/uni
UNI_REDIS_URL=redis://localhost:6379/0
UNI_OIDC_ISSUER=http://localhost:8080/realms/kalinowo
UNI_OIDC_AUDIENCE=uni-api
UNI_S3_BUCKET=uni-documents
UNI_S3_ENDPOINT_URL=http://localhost:9000
UNI_EMAIL_BACKEND=smtp
UNI_SMTP_HOST=localhost
UNI_SMTP_PORT=1025
UNI_CLAMAV_HOST=localhost

# Assistant. "hashing" needs no model download; production uses "e5" + "pgvector".
UNI_EMBEDDER=hashing
UNI_VECTOR_STORE=json
UNI_ASSISTANT_MIN_SCORE=0.2
UNI_ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# MinIO credentials for local S3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
